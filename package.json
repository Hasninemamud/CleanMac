{
  "name": "cleanmac",
  "productName": "CleanMac",
  "version": "2.1.0",
  "description": "Focused Mac space cleaner — junk, large files, duplicates",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "selfcheck": "node scripts/selfcheck.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac dmg",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "author": "CleanMac",
  "license": "MIT",
  "allowScripts": {
    "electron@37.10.3": true
  },
  "build": {
    "appId": "com.cleanmac.app",
    "productName": "CleanMac",
    "copyright": "Copyright © CleanMac",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": ["dmg"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "CleanMac ${version}",
      "icon": "build/icon.icns",
      "background": null,
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 420,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    }
  }
}
